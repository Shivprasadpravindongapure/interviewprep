# === REQUIRED FOR BASIC FUNCTIONALITY ===
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# === DATABASE (REQUIRED) ===
# Option 1: MongoDB Atlas (Recommended)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ecosense?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/ecosense

# === JWT SECRETS (REQUIRED) ===
# Generate these using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === ADMIN CREDENTIALS (REQUIRED) ===
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure_admin_password_here

# === OPTIONAL: Google OAuth ===
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# === OPTIONAL: AWS S3 (for video recording storage) ===
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_unique_bucket_name_here

# === OPTIONAL: Redis (for sessions/caching) ===
REDIS_URL=redis://localhost:6379

# === OPTIONAL: OpenAI (for enhanced AI features) ===
OPENAI_API_KEY=sk-your-openai-api-key-here
